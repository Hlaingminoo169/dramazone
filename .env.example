# ══════════════════════════════════════════════════════════════════════════════
# DramaZone VIP Telegram Bot — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────
APP_NAME=DramaZone VIP Bot
APP_ENV=development
# development | production
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL

# ──────────────────────────────────────────────
# MONGODB
# ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dramazone

# Connection pool (tune for VPS resources)
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ──────────────────────────────────────────────
# TELEGRAM BOTS
# ──────────────────────────────────────────────
# Customer-facing bot
CUSTOMER_BOT_TOKEN=

# Admin-facing bot (separate bot for admin operations)
ADMIN_BOT_TOKEN=

# Webhook security secret (generated random string, min 32 chars)
# Used to verify that webhook requests come from Telegram
WEBHOOK_SECRET=

# Public HTTPS base URL where this service is reachable
# Example: https://dramazone.yourdomain.com
WEBHOOK_BASE_URL=

# ──────────────────────────────────────────────
# ADMIN ACCESS (req #4)
# Comma-separated Telegram numeric user IDs — NOT usernames
# Usernames can change; numeric IDs are permanent
# ──────────────────────────────────────────────
ADMIN_TELEGRAM_IDS=1673861706,1655754454

# ──────────────────────────────────────────────
# RATE LIMITING (req #2)
# MongoDB TTL-based — no Redis required
# ──────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# General callback/command window (seconds)
RATE_LIMIT_WINDOW_SECONDS=60

# Max requests per user in the window above
RATE_LIMIT_MAX_REQUESTS=30

# Max orders a user can create per hour
ORDER_RATE_LIMIT=5

# Max screenshots a user can submit per order
SCREENSHOT_RATE_LIMIT=3

# Cooldown after /start command (seconds)
START_COOLDOWN_SECONDS=10

# ──────────────────────────────────────────────
# SESSION (req #30, #31)
# MongoDB-backed sessions for state recovery
# ──────────────────────────────────────────────
SESSION_EXPIRY_HOURS=24

# ──────────────────────────────────────────────
# REPORTING & TIMEZONE (req #37)
# All timestamps stored in UTC, displayed in report timezone
# ──────────────────────────────────────────────
REPORT_TIMEZONE=Asia/Yangon

# ──────────────────────────────────────────────
# PAYMENT ACCOUNTS (req #24)
# Shown to customers in payment instructions
# ──────────────────────────────────────────────
PAYMENT_AYAPAY_NAME=Hlaing Min Oo
PAYMENT_AYAPAY_PHONE=09768908422

PAYMENT_UABPAY_NAME=Hlaing Min Oo
PAYMENT_UABPAY_PHONE=09768908422

PAYMENT_KPAY_NAME=Myat Nyein Ngon
PAYMENT_KPAY_PHONE=09777720344

PAYMENT_WAVE_NAME=Myat Nyein Ngon
PAYMENT_WAVE_PHONE=09777720344

# ──────────────────────────────────────────────
# PRICING (req #16 — package pricing)
# Prices in MMK — 1, 3, 5 movie packages only
# ──────────────────────────────────────────────
PRICE_1_MOVIE=1500
PRICE_3_MOVIES=3500
PRICE_5_MOVIES=5000

# ──────────────────────────────────────────────
# SECURITY MISC (req #1)
# ──────────────────────────────────────────────
# Max webhook request body size in bytes (10 MB default)
MAX_REQUEST_SIZE_BYTES=10485760
