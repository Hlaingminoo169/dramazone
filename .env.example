# -- MongoDB ------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=dramazone_vip

# -- Telegram Bot Tokens ------------------------------------------------------
CUSTOMER_BOT_TOKEN=
ADMIN_BOT_TOKEN=

# -- Deployment mode ----------------------------------------------------------
# 'polling' for local dev -- change to 'webhook' in production
BOT_MODE=polling

# -- Server port --------------------------------------------------------------
PORT=8000

# -- Admins -------------------------------------------------------------------
# Comma-separated Telegram user IDs of authorised admins
ADMIN_TELEGRAM_IDS=
ADMIN_USERNAME=

# -- Payment account details --------------------------------------------------
KPAY_PHONE=
KPAY_ACCOUNT_NAME=
WAVE_PHONE=
WAVE_ACCOUNT_NAME=
AYAPAY_PHONE=
AYAPAY_ACCOUNT_NAME=
UABPAY_PHONE=
UABPAY_ACCOUNT_NAME=

# -- Webhook secrets (generate random strings for production) -----------------
CUSTOMER_WEBHOOK_SECRET=
ADMIN_WEBHOOK_SECRET=

# -- Webhook URL (required when BOT_MODE=webhook) ----------------------------
WEBHOOK_BASE_URL=

# -- QR Codes (optional -- pre-uploaded Telegram file IDs) -------------------
QR_KPAY_FILE_ID=
QR_WAVE_FILE_ID=
QR_AYAPAY_FILE_ID=
QR_UABPAY_FILE_ID=
