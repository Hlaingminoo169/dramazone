# ──────────────────────────────────────────────
# DramaZone VIP Telegram Bot — .gitignore
# ──────────────────────────────────────────────

# Environment / Secrets — NEVER commit these
.env
.env.local
.env.production
.env.staging
*.env

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.coveragerc

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files (screenshot uploads etc.)
tmp/
temp/
uploads/

# Uvicorn / Gunicorn PID
*.pid

# Deployment
*.pem
*.key
*.cert
